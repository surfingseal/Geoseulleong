  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "nickname",
          "status",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "nickname": {
            "type": "string",
            "minLength": 2,
            "maxLength": 20
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Signup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password",
          "password_confirm",
          "nickname",
          "terms_agreed",
          "privacy_agreed"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "앞뒤 공백 제거, ASCII 소문자로 정규화. 표시 이름 없는 이메일."
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 20,
            "writeOnly": true,
            "description": "영문·숫자·ASCII 특수문자 각각 1개 이상, 공백/제어 문자 금지, UTF-8 72바이트 이하."
          },
          "password_confirm": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "description": "password와 일치"
          },
          "nickname": {
            "type": "string",
            "minLength": 2,
            "maxLength": 20,
            "description": "공백·제어·보이지 않는 형식 문자 금지. NFC 및 대소문자 무시 중복 검사."
          },
          "terms_agreed": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "privacy_agreed": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "example": {
          "email": "student@example.com",
          "password": "Example9!Only",
          "password_confirm": "Example9!Only",
          "nickname": "거슬렁학생",
          "terms_agreed": true,
          "privacy_agreed": true
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true
          }
        },
        "example": {
          "email": "student@example.com",
          "password": "Example9!Only"
        }
      },
      "Refresh": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refresh_token"
        ],
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "writeOnly": true,
            "description": "서버가 발급한 opaque 토큰. Android 보안 저장소에 보관."
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "user",
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in",
          "refresh_expires_in"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "access_token": {
            "type": "string",
            "description": "15분 JWT; 이 문서에는 실제 토큰을 포함하지 않음"
          },
          "refresh_token": {
            "type": "string",
            "description": "회전형 30일 세션, 원문은 DB 미저장"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "example": 900
          },
          "refresh_expires_in": {
            "type": "integer",
            "example": 2592000
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "user"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "AlternativeItinerary": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "reference_only"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "total_journey_minutes": {
            "type": "number",
            "nullable": true
          },
          "known_minutes": {
            "type": "number"
          },
          "walking_minutes": {
            "type": "number",
            "nullable": true
          },
          "transfer_count": {
            "type": "integer",
            "nullable": true
          },
          "time_basis": {
            "type": "string"
          },
          "express_wait_minutes": {
            "type": "number",
            "nullable": true
          },
          "reachability": {
            "type": "string",
            "enum": [
              "reachable",
              "unreachable",
              "unknown"
            ]
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "access",
                    "express",
                    "onward"
                  ]
                },
                "duration_minutes": {
                  "type": "number",
                  "nullable": true
                },
                "known_minutes": {
                  "type": "number"
                },
                "legs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "object"
                      },
                      "to": {
                        "type": "object"
                      },
                      "mode": {
                        "type": "string"
                      },
                      "duration_minutes": {
                        "type": "number",
                        "nullable": true
                      },
                      "same_vehicle_continuation": {
                        "type": "boolean"
                      },
                      "data_origin": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "vehicles": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "realtime_reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "includes_express_wait": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "AlternativeExpressSegment": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "reason_code": {
            "type": "string"
          },
          "gbis_route_id": {
            "type": "string"
          },
          "boarding_gbis_stop_id": {
            "type": "string"
          },
          "alighting_gbis_stop_id": {
            "type": "string"
          },
          "duration_minutes": {
            "type": "number",
            "nullable": true
          },
          "data_origin": {
            "type": "string"
          }
        }
      }
    }
  }
}
