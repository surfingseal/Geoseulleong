    "/api/v1/journeys/boarding-recommendations": {
      "get": {
        "tags": [
          "대체 승차 경로"
        ],
        "summary": "낮은 CGST 후보·접근 경로·실시간 도착 가능성 비교",
        "description": "기존 journeys의 search_id 및 provider path_index/leg_index로 실제 검색 결과 또는 기록 경로를 선택합니다. 추가 원래 경로 검색 없이 후보 최대3개의 접근·GBIS·CGST를 연결합니다. 미확인 값은 null/unknown입니다. 누락 구간은 기존 승인·예산 내 ODsay 클라이언트로 조회해 일치하는 버스 구간 시간만 합산합니다. 추가 구간 최대3회, 접근 포함 검색 상한6회.",
        "security": [],
        "parameters": [
          {
            "name": "search_id",
            "in": "query",
            "required": false,
            "description": "journeys 응답의 32자리 ID. 실제 검색 모드 필수. 기록 모드는 기존 생략 호출 유지.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          {
            "name": "path_index",
            "in": "query",
            "required": false,
            "description": "journeys 응답의 path_index / provider_index 값. 추천 순위가 아님.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "leg_index",
            "in": "query",
            "required": false,
            "description": "선택한 광역버스 구간 순번. 기록 예제=1.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "service_date",
            "in": "query",
            "required": true,
            "description": "CGST 비교 기준 날짜, YYYY-MM-DD",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-02"
            }
          },
          {
            "name": "tzon",
            "in": "query",
            "required": true,
            "description": "원본 시간대 코드 두 자리",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{2}$",
              "example": "08"
            }
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "description": "방문 순번 탐색 범위, 1~20, 기본10",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          },
          {
            "name": "origin_lon",
            "in": "query",
            "required": false,
            "description": "접근 검색 출발 경도. origin_lat와 함께 입력",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "origin_lat",
            "in": "query",
            "required": false,
            "description": "접근 검색 출발 위도. origin_lon과 함께 입력",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "후보와 비교 결과",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "original_journey": {
                      "type": "object"
                    },
                    "candidates": {
                      "type": "array",
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "properties": {
                          "recommendation_status": {
                            "type": "string",
                            "enum": [
                              "recommended",
                              "unreachable",
                              "excluded",
                              "unknown"
                            ]
                          },
                          "recommendation_rank": {
                            "type": "integer",
                            "nullable": true
                          },
                          "comparison": {
                            "type": "object"
                          },
                          "itinerary": {
                            "$ref": "#/components/schemas/AlternativeItinerary"
                          },
                          "express_segment": {
                            "$ref": "#/components/schemas/AlternativeExpressSegment"
                          }
                        }
                      }
                    },
                    "original_itinerary": {
                      "$ref": "#/components/schemas/AlternativeItinerary"
                    }
                  }
                },
                "example": {
                  "original_profile": {
                    "status": "available",
                    "mean_cgst": 60.333333333333336,
                    "p90_cgst": 67.6,
                    "observation_count": 3,
                    "numeric_count": 3,
